<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ siteUrl }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} updates" href="/feed.xml">
  <link rel="icon" href="/assets/flag.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/site.css">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
  {%- set card = og[page.url] or og["/"] %}
  <meta property="og:image" content="{{ siteUrl }}/assets/og/{{ card.file }}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Jolly Roger flag with the words &ldquo;{{ card.title }}&rdquo; and &ldquo;{{ card.line }}&rdquo;">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ siteUrl }}/assets/og/{{ card.file }}">
  <meta name="generator" content="Eleventy">
  {%- if site.webmcpOriginTrialToken %}
  <meta http-equiv="origin-trial" content="{{ site.webmcpOriginTrialToken }}">
  {%- endif %}
  <meta name="jrc:repo-url" content="{{ repoUrl }}">
  <meta name="jrc:site-url" content="{{ siteUrl }}">
  <script type="module" src="/assets/webmcp.js"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href="/"><img src="/assets/flag.svg" alt="" width="40" height="28"> <span>{{ site.title }}</span></a>
      <nav aria-label="Primary">
        <ul>
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>
  <p class="status-bar"><span class="wrap">{{ site.status }} <a href="/status/">Current status</a>.</span></p>
  <main id="main" class="wrap{% if wide %} wide{% endif %}">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <nav aria-label="Secondary">
        <ul>
          {%- for item in site.footerNav %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
          <li><a href="{{ repoUrl }}">Source</a></li>
        </ul>
      </nav>
      <p class="build">Built {{ buildTime | truncate(10, true, "") }}{% if git.commit %} from commit <a href="{{ repoUrl }}/commit/{{ git.commit }}"><code>{{ git.commit | truncate(7, true, "") }}</code></a>{% endif %}. Original content dedicated to the public domain under <a href="{{ repoUrl }}/blob/main/LICENSE">CC0 1.0</a>, with <a href="{{ repoUrl }}/blob/main/NOTICE.md">exclusions</a>.</p>
    </div>
  </footer>
</body>
</html>
