{
  "name": "jolly-roger-charter",
  "version": "0.1.0",
  "private": true,
  "description": "Founding documents and static website for the Jolly Roger Charter (JRCv1 draft).",
  "license": "CC0-1.0",
  "type": "module",
  "bin": {
    "jrc": "bin/jrc.mjs",
    "qm": "bin/qm.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "spec/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "manifest": "node scripts/hash-manifest.mjs",
    "status": "node scripts/render-status.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "jrc": "node bin/jrc.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "ajv": "8.20.0",
    "markdown-it": "14.3.2"
  }
}
